APP_NAME=ForgeFlow_AI
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://forge-flow-ai-theta.vercel.app/

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =====================================================================
# AI Copilot
# ---------------------------------------------------------------------
# Preferred provider tried first. Fallback order is always:
#   groq -> gemini -> hermes(ollama) -> mock
# Leave a key blank to skip that provider automatically.
# =====================================================================
AI_PROVIDER=groq
AI_MAX_EXECUTION_SECONDS=180
AI_RETRY_ATTEMPTS=2
AI_RETRY_DELAY_MS=400

# Groq (https://console.groq.com) — fast OpenAI-compatible free tier
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_CONNECT_TIMEOUT=5
GROQ_TIMEOUT_SECONDS=45

# Google Gemini (https://aistudio.google.com) — OpenAI-compatible endpoint
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CONNECT_TIMEOUT=5
GEMINI_TIMEOUT_SECONDS=45

# Local Hermes / OpenClaw / Ollama (only used when the server is running
# AND the model is installed). Start it with: ollama run qwen2.5-coder:latest
HERMES_API_BASE=http://127.0.0.1:11434/v1
HERMES_MODEL=qwen2.5-coder:latest
HERMES_API_KEY=sk-none
HERMES_CONNECT_TIMEOUT=5
HERMES_TIMEOUT_SECONDS=90
HERMES_HEALTH_CONNECT_TIMEOUT=2
HERMES_HEALTH_TIMEOUT=3
