# Backend Configuration
APP_NAME=_AI
APP_ENV=production
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# SQLite Database
DB_CONNECTION=sqlite
DB_DATABASE=c:/AI-Agents/forge2-qualifier/backend/database/database.sqlite

# AI Provider Configuration (Hermes/OpenClaw via Ollama, Groq, or Gemini)
AI_PROVIDER=groq
AI_MAX_EXECUTION_SECONDS=300

# Groq (free tier — get key at https://console.groq.com)
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (free tier — get key at https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash

# Local Ollama / Hermes (OpenAI-compatible endpoint)
HERMES_API_BASE=http://localhost:11434/v1
HERMES_MODEL=qwen2.5-coder:latest
HERMES_API_KEY=sk-none
HERMES_TIMEOUT_SECONDS=200

# Slack Bot Configuration (Optional for Slack integration)
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=

# Frontend API Endpoint
VITE_API_URL=http://127.0.0.1:8000/api
